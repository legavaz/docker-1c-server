# Настройки bsl-check-mcp.
# Запускается на Windows (OpenCode Desktop), проверяет .bsl через BSL Language Server
# в Docker на VM. Переменные окружения перекрывают значения отсюда.

# SSH-доступ к VM (как в AGENTS.md)
SSH_HOST=kali
SSH_KEY=C:\Users\lega\.ssh\opencode_vm

# Каталог с bsl-check.sh на VM
VM_BSL_DIR=/home/kali/bsl-docker
VM_REPORT_DIR=/srv/bsl-reports

# Соответствие Windows-каталог -> VM-каталог (SMB-шара).
# Файлы из этих каталогов передаются как есть, без пофайлового копирования.
#   Windows: E:\rep      VM: /srv/rep
WSL_MAP=E:\rep=/srv/rep

# Куда складывать временные копии файлов вне WSL_MAP (на VM)
VM_TMP_DIR=/home/kali/bsl-inbox

# Таймаут одной проверки, мс (по умолчанию 15 мин)
TIMEOUT_MS=900000

# Оставлять ли копии присланных файлов на VM после проверки (true/false)
KEEP_STAGED=false
